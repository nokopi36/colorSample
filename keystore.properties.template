# リリース署名の設定テンプレート。
#
# このファイルを keystore.properties という名前でコピーし、自分の値を入れてください。
# keystore.properties は .gitignore 済みなので、コミットされません。
# 鍵とパスワードは絶対にリポジトリへ入れないこと。
#
#   cp keystore.properties.template keystore.properties
#
# 用意できたら、署名済みの AAB は次のコマンドで出ます。
#
#   ./gradlew bundleRelease
#   → app/build/outputs/bundle/release/app-release.aab
#
# このファイルが無い場合、release ビルドは未署名で出力されます
# （ビルドは失敗しません）。ストアへ上げるには署名が必要です。

# keystore ファイルの場所。プロジェクト直下からの相対パス、または絶対パス。
# 例) storeFile=../keystore/upload.jks
#     storeFile=C:/Users/nokop/keys/upload.jks
storeFile=

# keystore 自体のパスワード
storePassword=

# 使う鍵の別名（エイリアス）
keyAlias=

# 鍵のパスワード（keystore と同じ場合も多い）
keyPassword=
